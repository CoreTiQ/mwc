uint32_t lastButtonCheck = 0;
bool buttonStates[] = {HIGH, HIGH, HIGH, HIGH};
bool lastButtonStates[] = {HIGH, HIGH, HIGH, HIGH};

void saveSettings() {
    EEPROM.put(0, settings);
}

void loadSettings() {
    EEPROM.get(0, settings);
    if(settings.brightnessIndex >= NUM_BRIGHTNESS_LEVELS) settings.brightnessIndex = 2;
    if(settings.colorIndex >= NUM_COLORS) settings.colorIndex = 0;
}

void setup() {
    Serial.begin(9600);
    
    pinMode(HOUR_BUTTON, INPUT_PULLUP);
    pinMode(MINUTE_BUTTON, INPUT_PULLUP);
    pinMode(BRIGHT_BUTTON, INPUT_PULLUP);
    pinMode(COLOR_BUTTON, INPUT_PULLUP);
    
    FastLED.addLeds<WS2812B, LED_PIN, GRB>(leds, NUM_LEDS);
    loadSettings();
    FastLED.setBrightness(BRIGHTNESS_LEVELS[settings.brightnessIndex]);
    
    if (!rtc.begin()) {
        Serial.println(F("RTC not found"));
        while (1);
    }

    if (!rtc.isrunning()) {
        rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
    }
    
    testDisplay();
}

void testDisplay() {
    // اختبار جميع المصابيح
    fill_solid(leds, NUM_LEDS, colorPairs[settings.colorIndex].active);
    FastLED.show();
    delay(1000);
    
    FastLED.clear();
    FastLED.show();
    delay(1000);
    
    // اختبار كل LED على حدة
    for (int i = 0; i < NUM_LEDS; i++) {
        FastLED.clear();
        leds[i] = colorPairs[settings.colorIndex].active;
        FastLED.show();
        delay(100);
    }
}

void checkButtons() {
    if (millis() - lastButtonCheck < BUTTON_DEBOUNCE_DELAY) return;
    lastButtonCheck = millis();

    const uint8_t buttons[] = {HOUR_BUTTON, MINUTE_BUTTON, BRIGHT_BUTTON, COLOR_BUTTON};
    
    for(uint8_t i = 0; i < 4; i++) {
        buttonStates[i] = digitalRead(buttons[i]);
        if(buttonStates[i] == LOW && lastButtonStates[i] == HIGH) {
            handleButton(i);
        }
        lastButtonStates[i] = buttonStates[i];
    }
}

void handleButton(uint8_t button) {
    DateTime now;
    switch(button) {
        case 0: // HOUR
            now = rtc.now();
            rtc.adjust(DateTime(now.year(), now.month(), now.day(), 
                      (now.hour() + 1) % 24, now.minute(), now.second()));
            break;
        case 1: // MINUTE
            now = rtc.now();
            rtc.adjust(DateTime(now.year(), now.month(), now.day(),
                      now.hour(), ((now.minute() + 5) / 5 * 5) % 60, now.second()));
            break;
        case 2: // BRIGHTNESS
            settings.brightnessIndex = (settings.brightnessIndex + 1) % NUM_BRIGHTNESS_LEVELS;
            FastLED.setBrightness(BRIGHTNESS_LEVELS[settings.brightnessIndex]);
            saveSettings();
            break;
        case 3: // COLOR
            settings.colorIndex = (settings.colorIndex + 1) % NUM_COLORS;
            saveSettings();
            break;
    }
}

void displayTime(uint8_t hours, uint8_t minutes) {
    FastLED.clear();
    
    if (hours > 12) hours -= 12;
    if (hours == 0) hours = 12;
    
    uint16_t configIndex = ((hours - 1) * 12) + (minutes / 5);
    const uint8_t* config = TIME_CONFIGS[configIndex];
    ColorPair currentColors = colorPairs[settings.colorIndex];
    
    for (uint8_t i = 0; pgm_read_byte(&config[i]) != 255; i++) {
        uint8_t ledIndex = pgm_read_byte(&config[i]);
        leds[ledIndex] = (ledIndex <= 1) ? currentColors.base : currentColors.active;
    }
    
    FastLED.show();
}

void loop() {
    checkButtons();
    
    EVERY_N_MILLISECONDS(UPDATE_INTERVAL) {
        DateTime now = rtc.now();
        displayTime(now.hour(), now.minute());
    }
}
