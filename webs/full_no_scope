        let customTimeMode = false;

        function initializeGrid() {
            const grid = document.getElementById('wordGrid');
            wordList.forEach(word => {
                const wordSpan = document.createElement('span');
                wordSpan.textContent = word.text;
                wordSpan.className = 'word';
                wordSpan.setAttribute('data-index', word.index);
                if (word.index <= 1) {
                    wordSpan.classList.add('base-word');
                }
                grid.appendChild(wordSpan);
            });
        }

        function clearActiveWords() {
            document.querySelectorAll('.word').forEach(word => {
                if (!word.classList.contains('base-word')) {
                    word.classList.remove('active');
                }
            });
        }

        function activateWordsByIndices(indices) {
            clearActiveWords();
            indices.forEach(index => {
                const element = document.querySelector(`[data-index="${index}"]`);
                if (element && !element.classList.contains('base-word')) {
                    element.classList.add('active');
                }
            });
        }

        function getNearestMinuteConfiguration(minutes) {
            const times = Object.keys(timeConfigurations[12]).map(Number);
            const nearestTime = times.reduce((prev, curr) => {
                return (Math.abs(curr - minutes) < Math.abs(prev - minutes) ? curr : prev);
            });
            return nearestTime.toString();
        }

        function updateClock(testHour = null, testMinute = null) {
            const now = new Date();
            let hours = testHour !== null ? testHour : now.getHours();
            let minutes = testMinute !== null ? testMinute : now.getMinutes();

            document.getElementById('time-display').textContent = 
                `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}`;

            if (hours > 12) hours -= 12;
            if (hours === 0) hours = 12;

            const nearestMinute = getNearestMinuteConfiguration(minutes);
            const activeIndices = timeConfigurations[hours][nearestMinute];
            
            if (activeIndices) {
                activateWordsByIndices(activeIndices);
            }

            document.getElementById('hourInput').value = hours;
            document.getElementById('minuteInput').value = minutes;
        }

        function setCustomTime() {
            const hours = parseInt(document.getElementById('hourInput').value) || 12;
            const minutes = parseInt(document.getElementById('minuteInput').value) || 0;
            
            if (hours < 1 || hours > 12 || minutes < 0 || minutes > 59) {
                alert('الرجاء إدخال وقت صحيح');
                return;
            }
            
            customTimeMode = true;
            updateClock(hours, minutes);
        }

        function resetToCurrentTime() {
            customTimeMode = false;
            updateClock();
        }

        function runTests() {
            const testTimes = [
                { h: 12, m: 0 },
                { h: 12, m: 15 },
                { h: 12, m: 30 },
                { h: 12, m: 45 },
                { h: 1, m: 0 },
                { h: 1, m: 15 },
                { h: 1, m: 30 },
                { h: 1, m: 45 }
            ];

            let currentTest = 0;
            customTimeMode = true;

            function runNextTest() {
                if (currentTest >= testTimes.length) {
                    customTimeMode = false;
                    return;
                }

                const test = testTimes[currentTest];
                updateClock(test.h, test.m);
                currentTest++;
                setTimeout(runNextTest, 3000);
            }

            runNextTest();
        }

        initializeGrid();
        resetToCurrentTime();

        setInterval(() => {
            if (!customTimeMode) {
                resetToCurrentTime();
            }
        }, 1000);
    </script>
</body>
</html>