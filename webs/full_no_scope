<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>ساعة الكلمات العربية</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #1a1a1a;
            font-family: Arial, sans-serif;
            padding: 20px;
        }
        
        .clock-container {
            width: 800px;
            height: 600px;
            background-color: #1f2937;
            padding: 40px;
            position: relative;
            box-shadow: 0 0 40px rgba(0,0,0,0.5);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .word-grid {
            width: 100%;
            height: 100%;
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            grid-template-rows: repeat(7, 1fr);
            gap: 8px;
            padding: 20px;
            background-color: #111827;
            border-radius: 5px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.3);
        }
        
        .word {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255, 255, 255, 0.1);
            font-size: 18px;
            transition: all 0.5s ease;
            text-align: center;
            padding: 8px;
        }
        
        .word::before {
            content: attr(data-index);
            position: absolute;
            top: 2px;
            right: 2px;
            font-size: 8px;
            color: rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.1);
            padding: 2px 4px;
            border-radius: 3px;
        }
        
        .active {
            color: white;
            text-shadow: 0 0 10px #fff,
                       0 0 20px #fff,
                       0 0 30px #e60073,
                       0 0 40px #e60073;
        }

        .base-word {
            color: white;
            text-shadow: 0 0 10px rgba(255,255,255,0.8);
        }

        .controls {
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(31, 41, 55, 0.95);
            padding: 20px;
            border-radius: 10px;
            color: white;
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }
        
        .time-input {
            display: flex;
            gap: 15px;
            align-items: center;
            margin-bottom: 15px;
        }
        
        input[type="number"] {
            width: 70px;
            padding: 8px;
            border: none;
            border-radius: 5px;
            background: rgba(255,255,255,0.1);
            color: white;
            font-size: 16px;
            text-align: center;
        }
        
        button {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            background: #3b82f6;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 0 5px;
        }
        
        button:hover {
            background: #2563eb;
            transform: translateY(-2px);
        }

        #time-display {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(31, 41, 55, 0.95);
            padding: 15px 30px;
            color: white;
            border-radius: 8px;
            font-size: 24px;
            font-weight: bold;
            direction: ltr;
            box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        }
    </style>
</head>
